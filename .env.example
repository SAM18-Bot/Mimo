# ── Required ──────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Optional (hardware) ───────────────────────────────
DATABASE_URL=sqlite:///./accountability.db
ESP32_STREAM_URL=http://192.168.1.100:81/stream

# ── Testing mode (no hardware needed) ────────────────
# Set both to 1 to run without ESP32-CAM or microphone
NO_HARDWARE=1
NO_VOICE=1
