# ── Required ──────────────────────────────────────────
# Gemini API key is strictly required for the AI engine.
GEMINI_API_KEY=your-gemini-key-here

# ── Auth ──────────────────────────────────────────────
# Set a shared, randomly generated key for deployments. Local sessions can use a process-local key.
JWT_SECRET_KEY=
SECRET_KEY=
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Optional (database) ──────────────────────────────
DATABASE_URL=sqlite:///./accountability.db

# ── Optional (hardware) ───────────────────────────────
ESP32_STREAM_URL=http://192.168.1.100:81/stream

# ── Testing mode (no hardware needed) ────────────────
# Set both to 1 to run without ESP32-CAM or microphone
NO_HARDWARE=1
NO_VOICE=1
